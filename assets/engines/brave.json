{
  "schemaVersion": 1,
  "id": "brave",
  "variant": "api",
  "name": "Brave Search API",
  "description": "API キーが必要。環境変数 BRAVE_API_KEY を value_env で参照する。",
  "enabled": true,
  "tags": ["general", "api"],
  "network": "default",
  "request": {
    "method": "GET",
    "url": "https://api.search.brave.com/res/v1/web/search",
    "query": {
      "q": "{{query}}",
      "offset": "{{offset}}",
      "count": "{{limit}}",
      "country": "{{region}}"
    },
    "headers": {
      "Accept": "application/json",
      "X-Subscription-Token": { "value_env": "BRAVE_API_KEY" }
    },
    "encoding": "utf-8"
  },
  "response": {
    "kind": "json",
    "items": {
      "path": "web.results"
    },
    "fields": {
      "title": {
        "path": "title",
        "transform": ["strip_html", "trim", "collapse_ws"]
      },
      "url": {
        "path": "url",
        "transform": ["trim", "strip_tracking"]
      },
      "snippet": {
        "path": "description",
        "transform": ["strip_html", "collapse_ws"]
      },
      "site": {
        "path": "profile.name",
        "transform": ["trim"]
      },
      "published": {
        "path": "age",
        "transform": ["trim"]
      }
    },
    "errorWhen": [
      { "path": "error", "exists": true }
    ]
  },
  "paging": {
    "style": "offset",
    "offsetParam": "offset",
    "pageSize": 20,
    "maxResults": 60,
    "offsetStep": 20
  },
  "limits": {
    "maxResults": 60,
    "minIntervalMs": 1100,
    "maxPageSize": 20,
    "requiresApiKey": true
  },
  "defaults": {
    "locale": "ja",
    "region": "JP"
  }
}
